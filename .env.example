GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://www.eazinvoice.com/auth/google/callback
ADMIN_EMAIL=support@eazinvoice.com
ADMIN_EMAILS=info@eazinvoice.com,support@eazinvoice.com
ADMIN_ACCESS_KEY=eazinvoice-admin
EAZINVOICE_DATA_DIR=
NODE_ENV=development
EAZINVOICE_ENV=development

# Storage modes: memory for tests, json for local development, postgres for production.
# Production must use EAZINVOICE_STORAGE=postgres and must not silently fall back to JSON.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/eazinvoice
EAZINVOICE_STORAGE=json
EAZINVOICE_POSTGRES_SSL_REQUIRED=false
POSTGRES_POOL_SIZE=5
POSTGRES_CONNECTION_TIMEOUT_MS=10000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=15000
POSTGRES_QUERY_TIMEOUT_MS=20000
EAZINVOICE_POSTGRES_DUAL_WRITE=false
EAZINVOICE_CORE_TABLE_SYNC=false
EAZINVOICE_REPORTS_SOURCE=json
EAZINVOICE_ENTITLEMENTS_SOURCE=json

# Browser CORS allowlist. Production must be explicit and must not include localhost.
CORS_ALLOWED_ORIGINS=http://localhost:3001,https://www.eazinvoice.com

# Used to HMAC-hash Business/API keys at rest. Changing this invalidates existing API keys
# until a versioned secret migration is implemented, so keep it stable and rotate deliberately.
API_KEY_HASH_SECRET=replace_with_a_long_random_api_key_hash_secret

OTP_CHANNEL=email
SMS_OTP_ENABLED=false
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_public_key
EMAIL_OTP_EXPIRES_SECONDS=90

# Optional fallback when Supabase cannot send auth OTP email.
# Use your company mailbox SMTP credentials, e.g. Namecheap Private Email.
EMAIL_SMTP_HOST=mail.privateemail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=info@eazinvoice.com
EMAIL_SMTP_PASS=your_mailbox_or_app_password
EMAIL_SMTP_FROM=info@eazinvoice.com
EMAIL_SMTP_FROM_NAME=EazInvoice
EMAIL_SMTP_SECURE=true

# Razorpay live checkout. Keep secrets only in Render/local .env, never in frontend code.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
EAZINVOICE_PUBLIC_URL=https://www.eazinvoice.com
PUBLIC_BASE_URL=https://www.eazinvoice.com
PUBLIC_APP_URL=https://www.eazinvoice.com
MOBILE_APP_URL=eazinvoice://auth/callback

# SMS OTP is disabled for now. Add a paid SMS/WhatsApp provider later before enabling mobile verification.
